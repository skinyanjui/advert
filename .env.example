NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only: never prefix this key with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
REFERENCE_WEBHOOK_SECRET=
# Optional dedicated signing key. If absent the server-only Supabase key is used.
BOARD_SESSION_SECRET=
# Comma-separated admin emails for /admin/reports (server-only).
# ADMIN_EMAILS=you@example.com
# Set to 1 only after attaching an SMS provider (Twilio, etc.) in Supabase Auth → Phone.
# NEXT_PUBLIC_AUTH_PHONE=1
# Set to 1 only after enabling the Google provider in Supabase Auth → Providers.
# NEXT_PUBLIC_AUTH_GOOGLE=1
