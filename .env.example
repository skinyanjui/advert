NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public support/privacy contact shown in Terms, Privacy, and privacy-rights pages.
# NEXT_PUBLIC_SUPPORT_EMAIL=privacy@example.com
# Legal/controller identity. Required before replacing legal-page placeholders.
# LEGAL_OPERATOR_NAME=
# LEGAL_OPERATOR_ADDRESS=
# Conditional privacy contacts; configure only if applicable.
# PRIVACY_DPO_EMAIL=
# PRIVACY_EU_REPRESENTATIVE=
# DMCA safe-harbor readiness. Do not set REGISTERED=1 until Copyright Office registration is actually current.
# DMCA_AGENT_NAME=
# DMCA_AGENT_EMAIL=
# DMCA_AGENT_ADDRESS=
# DMCA_AGENT_PHONE=
# DMCA_AGENT_REGISTERED=0
# ISO date from the Copyright Office designation; keep current and renew before expiration.
# DMCA_AGENT_REGISTRATION_EXPIRES_ON=
# Server-side only: never prefix this key with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
REFERENCE_WEBHOOK_SECRET=
# Optional dedicated signing key. If absent the server-only Supabase key is used.
BOARD_SESSION_SECRET=
# Comma-separated admin emails for /admin/reports (server-only).
# ADMIN_EMAILS=you@example.com
# Distinct pending reports that auto-hide an ad (default 3).
# REPORT_AUTO_HIDE_THRESHOLD=3
# Required for GET /api/cron/expiry-reminders (Authorization: Bearer …).
# CRON_SECRET=
# Optional expiry reminder email via Resend (cron no-ops without these).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# Set to 1 only after attaching an SMS provider (Twilio, etc.) in Supabase Auth → Phone.
# NEXT_PUBLIC_AUTH_PHONE=1
# Set to 1 only after enabling the Google provider in Supabase Auth → Providers.
# NEXT_PUBLIC_AUTH_GOOGLE=1
