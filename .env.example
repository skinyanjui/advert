NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public support/privacy contact shown in Terms, Privacy, and privacy-rights pages.
# NEXT_PUBLIC_SUPPORT_EMAIL=privacy@example.com
# Legal/controller identity. Required before replacing legal-page placeholders.
# LEGAL_OPERATOR_NAME=
# LEGAL_OPERATOR_ADDRESS=
# Conditional privacy contacts; configure only if applicable.
# PRIVACY_DPO_EMAIL=
# PRIVACY_EU_REPRESENTATIVE=
# DMCA safe-harbor readiness. Do not set REGISTERED=1 until Copyright Office registration is actually current.
# DMCA_AGENT_NAME=
# DMCA_AGENT_EMAIL=
# DMCA_AGENT_ADDRESS=
# DMCA_AGENT_PHONE=
# DMCA_AGENT_REGISTERED=0
# ISO date from the Copyright Office designation; keep current and renew before expiration.
# DMCA_AGENT_REGISTRATION_EXPIRES_ON=
# Server-side only: never prefix this key with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
REFERENCE_WEBHOOK_SECRET=
# Optional dedicated signing key. If absent the server-only Supabase key is used.
BOARD_SESSION_SECRET=
# Bootstrap-only administrator emails. On first authenticated role resolution,
# the server persists the role in board_user_roles; the database row is authoritative afterward.
# ADMIN_EMAILS=you@example.com
# Distinct pending reports that auto-hide an ad (default 3).
# REPORT_AUTO_HIDE_THRESHOLD=3
# Required for GET /api/cron/expiry-reminders (Authorization: Bearer …).
# CRON_SECRET=
# Optional expiry reminder email via Resend (cron no-ops without these).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# Set to 1 only after attaching an SMS provider (Twilio, etc.) in Supabase Auth → Phone.
# NEXT_PUBLIC_AUTH_PHONE=1
# Set to 1 only after enabling the Google provider in Supabase Auth → Providers.
# NEXT_PUBLIC_AUTH_GOOGLE=1

# Assurance evidence. Server-side only. Configure only after the named independent
# report/certificate/assessment or formal program participation actually exists.
# COMPLIANCE_SOC2_REPORT=
# COMPLIANCE_ISO27001_CERTIFICATE=
# COMPLIANCE_CASA_TIER2_ASSESSMENT=
# COMPLIANCE_DPF_PARTICIPATION=
# COMPLIANCE_PCI_DSS_ATTESTATION=

# Product capability facts. Leave disabled unless the corresponding production
# feature is actually enabled; compliance scope is derived from these values.
# CAPABILITY_PAYMENT_PROCESSING=0
# CAPABILITY_MARKETING_EMAIL=0
# CAPABILITY_MARKETING_ROBOTEXTS=0
# CAPABILITY_THIRD_PARTY_AD_PIXELS=0
# CAPABILITY_SELLS_PERSONAL_INFORMATION=0
# CAPABILITY_CROSS_CONTEXT_ADVERTISING=0
# CAPABILITY_SIGNIFICANT_DECISION_ADMT=0

# Paid featuring: USD 10 / 7 days; review follows payment.
# Start with Stripe test mode. Server-only credentials.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Paid checkout also requires a valid NEXT_PUBLIC_SUPPORT_EMAIL, RESEND_API_KEY,
# RESEND_FROM_EMAIL and CRON_SECRET. Confirm the received verification code in
# Admin > Featured promotions after applying the payment-support migration.
# Optional separate operator alert destination (defaults to public support):
# PROMOTION_ALERT_EMAIL=
# Trusted HTTPS checkout return origin (local HTTP allowed for development).
# APP_BASE_URL=http://localhost:3000
